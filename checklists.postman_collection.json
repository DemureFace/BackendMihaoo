{
  "info": {
    "name": "Checklist Service",
    "_postman_id": "c1a2b3c4-d5e6-4f78-9a0b-checklist-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "checklistId", "value": "" },
    { "key": "completionId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tester@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) pm.collectionVariables.set('token', body.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tester@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) pm.collectionVariables.set('token', body.accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Checklists",
      "item": [
        {
          "name": "Create Checklist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Opening checklist\",\n  \"items\": [\n    { \"id\": \"1\", \"text\": \"Turn on lights\" },\n    { \"id\": \"2\", \"text\": \"Check cash drawer\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/checklists", "host": ["{{baseUrl}}"], "path": ["checklists"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.collectionVariables.set('checklistId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Checklists",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/checklists", "host": ["{{baseUrl}}"], "path": ["checklists"] }
          }
        },
        {
          "name": "Get Checklist",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/checklists/{{checklistId}}", "host": ["{{baseUrl}}"], "path": ["checklists", "{{checklistId}}"] }
          }
        },
        {
          "name": "Update Checklist",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Opening checklist (updated)\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/checklists/{{checklistId}}", "host": ["{{baseUrl}}"], "path": ["checklists", "{{checklistId}}"] }
          }
        },
        {
          "name": "Delete Checklist",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/checklists/{{checklistId}}", "host": ["{{baseUrl}}"], "path": ["checklists", "{{checklistId}}"] }
          }
        },
        {
          "name": "Submit Completion",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    { \"itemId\": \"1\", \"checked\": true },\n    { \"itemId\": \"2\", \"checked\": false }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/checklists/{{checklistId}}/completions", "host": ["{{baseUrl}}"], "path": ["checklists", "{{checklistId}}", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.collectionVariables.set('completionId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Completion",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/checklists/completions/{{completionId}}", "host": ["{{baseUrl}}"], "path": ["checklists", "completions", "{{completionId}}"] }
          }
        }
      ]
    }
  ]
}
