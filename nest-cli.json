{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/gateway",
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "currency-service": {
      "type": "application",
      "root": "apps/currency-service",
      "entryFile": "main",
      "sourceRoot": "apps/currency-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/currency-service/tsconfig.app.json"
      }
    },
    "tournament-service": {
      "type": "application",
      "root": "apps/tournament-service",
      "entryFile": "main",
      "sourceRoot": "apps/tournament-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tournament-service/tsconfig.app.json"
      }
    },
    "bonus-service": {
      "type": "application",
      "root": "apps/bonus-service",
      "entryFile": "main",
      "sourceRoot": "apps/bonus-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/bonus-service/tsconfig.app.json"
      }
    },
    "checklist-service": {
      "type": "application",
      "root": "apps/checklist-service",
      "entryFile": "main",
      "sourceRoot": "apps/checklist-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/checklist-service/tsconfig.app.json"
      }
    },
    "banner-export-service": {
      "type": "application",
      "root": "apps/banner-export-service",
      "entryFile": "main",
      "sourceRoot": "apps/banner-export-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/banner-export-service/tsconfig.app.json"
      }
    },
    "analytics-service": {
      "type": "application",
      "root": "apps/analytics-service",
      "entryFile": "main",
      "sourceRoot": "apps/analytics-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/analytics-service/tsconfig.app.json"
      }
    }
  }
}
