# Copy this file to .env for local (non-Docker) development.
# When running via docker-compose, these are instead injected as
# container environment variables in docker-compose.yml.

GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
CURRENCY_SERVICE_PORT=3003
TOURNAMENT_SERVICE_PORT=3004
BONUS_SERVICE_PORT=3005
CHECKLIST_SERVICE_PORT=3006
BANNER_EXPORT_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008

# Used by the gateway to reach the other services over HTTP
AUTH_SERVICE_URL=http://localhost:3001
CURRENCY_SERVICE_URL=http://localhost:3003
TOURNAMENT_SERVICE_URL=http://localhost:3004
BONUS_SERVICE_URL=http://localhost:3005
CHECKLIST_SERVICE_URL=http://localhost:3006
BANNER_EXPORT_SERVICE_URL=http://localhost:3007
ANALYTICS_SERVICE_URL=http://localhost:3008

AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auth_db?schema=public
TOURNAMENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/tournament_db?schema=public
CHECKLIST_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/checklist_db?schema=public
ANALYTICS_DATABASE_URL=postgresql://postgres:postgres@localhost:5437/analytics_db?schema=public

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# Comma-separated frontend origins allowed through the gateway's CORS policy.
# Unset locally on purpose — the gateway falls back to localhost:5173 +
# the production Netlify URL. Staging/production each set their own value.
CORS_ORIGINS=

GOOGLE_TRANSLATE_API_KEY=AIzaSyCkYo31T4oaHz0itTvwZRCcJ31wATJy9yI

# banner-export-service
# The public URL clients use to reach the gateway; used to build download links in the manifest/job payload.
BACKEND_PUBLIC_URL=http://localhost:3000
BANNER_EXPORT_STORAGE=./storage/banner-exports
# Set to 'true' to skip real Figma calls and generate placeholder banners (useful without a FIGMA_TOKEN).
FIGMA_MOCK_MODE=true
FIGMA_TOKEN=