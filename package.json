{
  "name": "mihaoo-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.17.x"
  },
  "scripts": {
    "build": "nest build",
    "build:all": "nest build gateway && nest build auth-service && nest build currency-service && nest build tournament-service && nest build bonus-service && nest build checklist-service && nest build banner-export-service && nest build analytics-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/gateway/main",
    "start:gateway:dev": "nest start gateway --watch",
    "start:auth:dev": "nest start auth-service --watch",
    "start:currency:dev": "nest start currency-service --watch",
    "start:tournament:dev": "nest start tournament-service --watch",
    "start:bonus:dev": "nest start bonus-service --watch",
    "start:checklist:dev": "nest start checklist-service --watch",
    "start:banner-export:dev": "nest start banner-export-service --watch",
    "start:analytics:dev": "nest start analytics-service --watch",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:gateway": "jest --config ./apps/gateway/test/jest-e2e.json",
    "test:e2e:auth": "jest --config ./apps/auth-service/test/jest-e2e.json",
    "test:e2e:tournament": "jest --config ./apps/tournament-service/test/jest-e2e.json",
    "prisma:generate": "npm run prisma:generate:auth && npm run prisma:generate:tournament && npm run prisma:generate:checklist && npm run prisma:generate:analytics",
    "prisma:generate:auth": "prisma generate --schema apps/auth-service/prisma/schema.prisma",
    "prisma:generate:tournament": "prisma generate --schema apps/tournament-service/prisma/schema.prisma",
    "prisma:generate:checklist": "prisma generate --schema apps/checklist-service/prisma/schema.prisma",
    "prisma:generate:analytics": "prisma generate --schema apps/analytics-service/prisma/schema.prisma",
    "prisma:validate": "npm run prisma:validate:auth && npm run prisma:validate:tournament && npm run prisma:validate:checklist && npm run prisma:validate:analytics",
    "prisma:validate:auth": "prisma validate --schema apps/auth-service/prisma/schema.prisma",
    "prisma:validate:tournament": "prisma validate --schema apps/tournament-service/prisma/schema.prisma",
    "prisma:validate:checklist": "prisma validate --schema apps/checklist-service/prisma/schema.prisma",
    "prisma:validate:analytics": "prisma validate --schema apps/analytics-service/prisma/schema.prisma",
    "prisma:migrate:auth": "prisma migrate dev --schema apps/auth-service/prisma/schema.prisma",
    "prisma:migrate:tournament": "prisma migrate dev --schema apps/tournament-service/prisma/schema.prisma",
    "prisma:migrate:checklist": "prisma migrate dev --schema apps/checklist-service/prisma/schema.prisma",
    "prisma:migrate:analytics": "prisma migrate dev --schema apps/analytics-service/prisma/schema.prisma",
    "prisma:deploy:auth": "prisma migrate deploy --schema apps/auth-service/prisma/schema.prisma",
    "prisma:deploy:tournament": "prisma migrate deploy --schema apps/tournament-service/prisma/schema.prisma",
    "prisma:deploy:checklist": "prisma migrate deploy --schema apps/checklist-service/prisma/schema.prisma",
    "prisma:deploy:analytics": "prisma migrate deploy --schema apps/analytics-service/prisma/schema.prisma",
    "prisma:seed:auth": "ts-node -r tsconfig-paths/register apps/auth-service/prisma/seed.ts",
    "prisma:seed:analytics": "ts-node -r tsconfig-paths/register apps/analytics-service/prisma/seed.ts",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "6.19.3",
    "adm-zip": "^0.5.18",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^common/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    }
  }
}
